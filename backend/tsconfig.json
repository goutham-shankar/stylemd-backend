{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "ignoreDeprecations": "5.0",
    "outDir": "../dist",
    "rootDir": "..",
    "baseUrl": "..",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../lib/**/*.ts"],
  "exclude": [
    "node_modules",
    "../node_modules",
    "../lib/**/__tests__/**",
    "../lib/**/*.test.ts",
    "src/**/__tests__/**",
    "src/**/*.test.ts"
  ]
}
