<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />
    <style>
      body { background: #0a0f1a; color: #e8f4ff; font-family: 'Inter', system-ui, sans-serif; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
      .error-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,80,80,0.25); border-radius: 16px; padding: 2.5rem 3rem; text-align: center; }
      .error-code { font-size: 72px; font-weight: 700; color: #ff5555; margin-bottom: 1rem; }
      .error-message { color: rgba(232,244,255,0.7); font-size: 15px; margin-bottom: 2rem; }
      .home-link { display: inline-flex; padding: 12px 24px; background: #4a9eff; color: #fff; text-decoration: none; border-radius: 10px; font-weight: 600; }
    </style>
  </head>
  <body>
    <div class="error-card">
      <div class="error-code"><%= statusCode %></div>
      <p class="error-message"><%= message %></p>
      <a href="/stylemd" class="home-link">← Back to Control Room</a>
    </div>
  </body>
</html>
