<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background: #0a0f1a;
        color: #e8f4ff;
        font-family: 'Inter', system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .toolbar {
        padding: 12px 20px;
        background: linear-gradient(135deg, rgba(15,20,40,0.97), rgba(10,25,50,0.97));
        border-bottom: 1px solid rgba(100,160,255,0.2);
        display: flex;
        align-items: center;
        gap: 12px;
        flex-shrink: 0;
      }
      .btn-download {
        padding: 10px 18px;
        background: linear-gradient(135deg, #00d9ff, #0099cc);
        color: #000;
        border: none;
        border-radius: 8px;
        font: 700 13px 'Inter', sans-serif;
        cursor: pointer;
        text-decoration: none;
      }
      .btn-back {
        padding: 8px 14px;
        background: rgba(255,255,255,0.07);
        color: #a8d0ff;
        border: 1px solid rgba(100,160,255,0.2);
        border-radius: 8px;
        font: 500 13px 'Inter', sans-serif;
        text-decoration: none;
      }
      .toolbar-meta { margin-left: auto; color: rgba(168,208,255,0.7); font-size: 12px; display: flex; gap: 8px; }
      .run-id-badge { background: rgba(74,158,255,0.1); border: 1px solid rgba(74,158,255,0.2); border-radius: 4px; padding: 2px 8px; font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #4a9eff; }
      .showcase-frame { flex: 1; border: none; display: block; width: 100%; }
    </style>
  </head>
  <body>
    <div class="toolbar">
      <a href="/stylemd" class="btn-back">← Control Room</a>
      <a id="btn-download" class="btn-download" href="<%= downloadUrl %>" download="styleguide-<%= runId %>.html">📥 Download HTML</a>
      <div class="toolbar-meta">
        <span>Generated with KIMI AI</span>
        <span class="run-id-badge"><%= runId %></span>
      </div>
    </div>
    <iframe id="showcase-iframe" title="styleguide-<%= runId %>" class="showcase-frame" src="<%= showcaseSrc %>" sandbox="allow-same-origin allow-scripts"></iframe>
  </body>
</html>
