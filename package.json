{
  "name": "stylemd-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--dns-result-order=ipv4first tsx watch --tsconfig tsconfig.json backend/src/index.ts",
    "dev:worker": "NODE_OPTIONS=--dns-result-order=ipv4first tsx watch --tsconfig tsconfig.json backend/src/worker.ts",
    "start": "NODE_ENV=production NODE_OPTIONS=--dns-result-order=ipv4first node dist/backend/src/index.js",
    "start:worker": "NODE_ENV=production NODE_OPTIONS=--dns-result-order=ipv4first node dist/backend/src/worker.js",
    "build:server": "tsc -p backend/tsconfig.json && tsc-alias -p backend/tsconfig.json && mkdir -p dist/backend/src/views && cp -r backend/src/views/* dist/backend/src/views/ && mkdir -p dist/backend/public && cp -r backend/public/* dist/backend/public/",
    "build:client": "cd backend && vite build",
    "build": "npm run build:server",
    "test": "tsx --test \"lib/stylemd-artifacts/__tests__/*.test.ts\" \"lib/services/__tests__/*.test.ts\" \"scripts/*.test.mjs\"",
    "report:stylemd-costs": "node scripts/stylemd-stage-costs.mjs",
    "migrate:runs": "node scripts/migrate-stylemd-runs.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@bull-board/api": "^8.0.0",
    "@bull-board/express": "^8.0.0",
    "bullmq": "^5.78.1",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^14.0.0",
    "ioredis": "^5.11.1",
    "mongoose": "^7.6.0",
    "playwright": "^1.59.1",
    "sharp": "^0.34.5",
    "ssim.js": "^3.5.0",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "nodemon": "^2.0.22",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.7.2",
    "vite": "^6.3.4"
  }
}
