{
  "name": "stylemd-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--dns-result-order=ipv4first tsx watch --tsconfig tsconfig.json backend/src/index.ts",
    "start": "NODE_OPTIONS=--dns-result-order=ipv4first tsx --tsconfig tsconfig.json backend/src/index.ts",
    "build:server": "tsc -p backend/tsconfig.json",
    "build:client": "cd backend && vite build",
    "build": "npm run build:client && npm run build:server",
    "test": "tsx --test \"lib/stylemd-artifacts/__tests__/*.test.ts\" \"lib/services/__tests__/*.test.ts\" \"scripts/*.test.mjs\"",
    "report:stylemd-costs": "node scripts/stylemd-stage-costs.mjs",
    "migrate:runs": "node scripts/migrate-stylemd-runs.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.104",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "mongoose": "^7.6.0",
    "playwright": "^1.59.1",
    "sharp": "^0.34.5",
    "ssim.js": "^3.5.0",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "nodemon": "^2.0.22",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "vite": "^6.3.4"
  }
}
