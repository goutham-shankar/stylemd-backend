# Required for provider=kimi runs
KIMI_API_KEY=sk-your-kimi-api-key-here

# Optional: model override for Claude provider
# CLAUDE_MODEL=claude-sonnet-4-5

# Optional: persist latest in-memory session state
PLAYGROUND_LOG_TO_FILE=false

# Optional: increase Kimi curation reasoning budget for higher accuracy (higher cost/latency)
STYLEMD_KIMI_CURATION_MAX_STEPS=160

# Optional: Path to system-installed Chrome (required for Ubuntu 26.04+ where Playwright Chromium binaries may fail)
# PLAYWRIGHT_CHROME_PATH=/usr/bin/google-chrome
