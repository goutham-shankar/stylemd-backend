# Required for provider=kimi runs
KIMI_API_KEY=sk-your-kimi-api-key-here

# Optional: model override for Claude provider
# CLAUDE_MODEL=claude-sonnet-4-5

# Optional: persist latest in-memory session state
PLAYGROUND_LOG_TO_FILE=false

# Optional: increase Kimi curation reasoning budget for higher accuracy (higher cost/latency)
STYLEMD_KIMI_CURATION_MAX_STEPS=160

# Optional: Path to system-installed Chrome (required for Ubuntu 26.04+ where Playwright Chromium binaries may fail)
# PLAYWRIGHT_CHROME_PATH=/usr/bin/google-chrome

# ─── Queue / Redis (required) ─────────────────────────────────────────────
# Local dev:  redis://127.0.0.1:6379
# VPS:        redis://default:<password>@127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379

# Optional queue tuning
WORKER_CONCURRENCY=2
WORKER_LOCK_MS=300000
QUEUE_MAX_WAITING=500

# ─── Cloudflare R2 object storage (required for worker uploads) ──────────
# From Cloudflare → R2 → Manage R2 API Tokens → Create Token (Object Read & Write)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_KEY=<access-key-id>
R2_SECRET=<secret-access-key>
R2_BUCKET=stylemd-runs
# Public URL base — either R2's public dev URL or your custom domain
R2_PUBLIC_BASE=https://pub-xxxxxxxxxxxx.r2.dev

# ─── Admin / Bull Board dashboard (required to access /admin/queues) ─────
# Set to a strong random token. Send as: Authorization: Bearer <token>
ADMIN_TOKEN=change-me-to-a-long-random-string
